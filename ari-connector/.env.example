# ── Asterisk ARI (LOCAL to this box — never leaves the Pi) ─────────────────────
# ari.conf must have: enabled = yes, and a user matching ARI_USER/ARI_SECRET.
ARI_URL=http://127.0.0.1:8088
ARI_USER=pydent
ARI_SECRET=change-me
# The Stasis application the dialplan hands calls to: Stasis(pydent-agent).
# Must match the "Stasis application name" in the Pydent pairing form.
STASIS_APP=pydent-agent

# ── Pydent pairing (from the "Save & pair box" screen in Pydent) ──────────────
# Paste the block Pydent shows you when you save the landline profile.
PYDENT_BASE=https://pydent.ai
PYDENT_DEVICE_TOKEN=paste-the-device-token-from-pydent

# ── Engine SIP endpoints (PJSIP endpoint names on this box) ───────────────────
# The connector hands each call to the voice engine over SIP by dialing
# PJSIP/<number>@<endpoint>. Define these endpoints in pjsip.conf (see README):
#   [livekit] → contact sip:<project>.sip.livekit.cloud   (Pydent → Settings → LiveKit shows the domain)
#   [vapi]    → contact sip:sip.vapi.ai
LIVEKIT_PJSIP_ENDPOINT=livekit
VAPI_PJSIP_ENDPOINT=vapi
