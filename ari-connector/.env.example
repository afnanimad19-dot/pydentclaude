# ── Asterisk ARI (on this same box) ───────────────────────────────────────────
# ari.conf must have: enabled = yes, and a user matching ARI_USER/ARI_SECRET.
ARI_URL=http://127.0.0.1:8088
ARI_USER=pydent
ARI_SECRET=change-me
# The Stasis application the dialplan hands calls to: Stasis(pydent-agent)
STASIS_APP=pydent-agent

# ── Pydent backend ────────────────────────────────────────────────────────────
# Where the Pydent app is deployed, and the shared token that authorises this box
# (must equal PYDENT_CONNECTOR_TOKEN set in the Pydent/Netlify environment).
PYDENT_BASE=https://pydent.ai
PYDENT_CONNECTOR_TOKEN=change-me-too
# The workspace this clinic's box belongs to (Pydent → Settings shows the id).
PYDENT_WS=00000000-0000-0000-0000-000000000000

# ── AudioSocket media server (this connector hosts it; Asterisk connects in) ──
# Address Asterisk should reach this process on. 127.0.0.1 when co-located.
AUDIOSOCKET_HOST=127.0.0.1
AUDIOSOCKET_PORT=9092
