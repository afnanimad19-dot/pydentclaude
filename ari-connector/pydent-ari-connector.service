[Unit]
Description=Pydent ARI connector (bridges Asterisk to Pydent AI voice agents)
After=network-online.target asterisk.service
Wants=network-online.target

[Service]
Type=simple
# Adjust User and WorkingDirectory to where you cloned this folder on the box.
User=pydent
WorkingDirectory=/opt/pydent-ari-connector
EnvironmentFile=/opt/pydent-ari-connector/.env
ExecStart=/usr/bin/node index.mjs
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
