# Port the middleware listens on (Cloudflare Tunnel points here).
PORT=4000

# Shared secret — must match the "Middleware API key" you set in Pydent → Settings → Open Dental.
CLINIC_API_KEY=change-me-to-a-long-random-string

# --- MODE -------------------------------------------------------------------
# Set to 1 to run WITHOUT a real Open Dental (safe in-memory mock for testing the
# whole booking chain). Leave unset/0 for live. If the DEVELOPER_KEY below is
# empty, the connector also falls back to mock automatically.
OPEN_DENTAL_MOCK=1

# --- LIVE (only needed when OPEN_DENTAL_MOCK is not 1) -----------------------
# Open Dental API. For a local eConnector this is typically http://localhost:30222/api/v1
OPEN_DENTAL_BASE_URL=http://localhost:30222/api/v1
OPEN_DENTAL_DEVELOPER_KEY=your-developer-key
OPEN_DENTAL_CUSTOMER_KEY=your-customer-key
