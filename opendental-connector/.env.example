# Port the middleware listens on (Cloudflare Tunnel points here).
PORT=4000

# Shared secret — must match the "Middleware API key" you set in Pydent → Settings → Open Dental.
# REQUIRED in every mode; startup fails without it. Use a long random string (16+ chars).
CLINIC_API_KEY=change-me-to-a-long-random-string

# --- MODE -------------------------------------------------------------------
# Mock mode is EXPLICIT: it runs ONLY when this is exactly 1 (safe in-memory
# data, nothing persisted). In any other case the connector is LIVE and refuses
# to start unless the Open Dental keys below are set — it never silently falls
# back to mock data.
OPEN_DENTAL_MOCK=1

# Read-only mode is ON by default: /create-appointment, /reschedule-appointment
# and /cancel-appointment return 403 without touching Open Dental. Set to 0
# ONLY when the clinic has signed off on live booking against the intended
# (test) database.
OPEN_DENTAL_READ_ONLY=1

# --- LIVE (required when OPEN_DENTAL_MOCK is not 1) ---------------------------
# Open Dental API base URL:
#   Local API (inside opendental.exe):  http://localhost:30222/api/v1
#   API Service (server install):       http://localhost:30223/api/v1
#   Remote (via Open Dental HQ):        https://api.opendental.com/api/v1
OPEN_DENTAL_BASE_URL=http://localhost:30222/api/v1
OPEN_DENTAL_DEVELOPER_KEY=your-developer-key
OPEN_DENTAL_CUSTOMER_KEY=your-customer-key

# Upstream request timeout in milliseconds (default 10000, clamped 1000–60000).
OPEN_DENTAL_TIMEOUT_MS=10000
