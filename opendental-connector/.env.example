# Port the middleware listens on (Cloudflare Tunnel points here).
PORT=4000

# Shared secret — must match the "Middleware API key" you set in Pydental → Settings.
CLINIC_API_KEY=change-me-to-a-long-random-string

# Open Dental API. For a local eConnector this is typically http://localhost:30222/api/v1
OPEN_DENTAL_BASE_URL=http://localhost:30222/api/v1
OPEN_DENTAL_DEVELOPER_KEY=your-developer-key
OPEN_DENTAL_CUSTOMER_KEY=your-customer-key
