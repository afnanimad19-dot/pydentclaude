# ── LiveKit project (from LiveKit Cloud → Settings → API keys) ──────────────
LIVEKIT_URL=wss://<your-project>.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ── Pydent ──────────────────────────────────────────────────────────────────
# Where Pydent is deployed; the worker fetches agent config + posts call logs here.
PYDENT_BASE=https://pydent.ai
# Worker token — Pydent generates this: Settings → Connections → LiveKit →
# "Generate worker token". Copy it here. (It is NOT something LiveKit issues.)
LIVEKIT_WORKER_TOKEN=paste-the-token-from-pydent-settings

# The agent name Pydent dispatches (keep in sync with Pydent → Settings → LiveKit).
AGENT_NAME=pydent-agent
